{
  "name": "@nextshopkit/sdk",
  "version": "0.5.2",
  "description": "Open-source NextShopKit SDK for Next.js + Shopify",
  "license": "MIT",
  "author": "Mustafa ONAL",
  "repository": {
    "type": "git",
    "url": "https://github.com/NextShopKit/sdk"
  },
  "homepage": "https://docs.nextshopkit.com/",
  "main": "dist/index.sdk.js",
  "module": "dist/index.sdk.mjs",
  "types": "dist/index.sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.sdk.d.ts",
      "import": "./dist/index.sdk.mjs",
      "require": "./dist/index.sdk.js"
    },
    "./client": {
      "types": "./dist/client/client.sdk.d.ts",
      "import": "./dist/client/client.sdk.mjs",
      "require": "./dist/client/client.sdk.js"
    }
  },
  "dependencies": {
    "lodash-es": "^4.17.21"
  },
  "keywords": [
    "shopify",
    "nextjs",
    "next.js",
    "sdk",
    "headless",
    "ecommerce",
    "typescript",
    "react",
    "storefront",
    "commerce",
    "api",
    "frontend",
    "cart",
    "checkout",
    "product"
  ],
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "tsup.config.ts",
    "tsup.pro.config.ts",
    "SEARCH_EXAMPLE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup --config tsup.config.ts --watch",
    "type:check": "tsc --noEmit",
    "build:core": "npm run build",
    "build:pro": "tsup --config tsup.pro.config.ts",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.13.16",
    "@types/react": "^18.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.0",
    "tsup": "^7.2.0",
    "typescript": "^5.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
